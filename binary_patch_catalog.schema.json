{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ZD1200 binary patch catalog",
  "type": "object",
  "required": ["catalog_version", "artifacts", "patches"],
  "additionalProperties": false,
  "properties": {
    "catalog_version": { "const": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "description", "handler"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string", "minLength": 1 },
          "handler": { "enum": ["raw", "zd1200_bzimage_gzip_elf"] }
        }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "name", "signature_hex", "patch_offset", "expected_hex", "replacement_hex", "description"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "signature_hex": { "type": "string", "minLength": 1 },
          "patch_offset": { "type": "integer", "minimum": 0 },
          "expected_hex": { "type": "string", "minLength": 1 },
          "replacement_hex": { "type": ["string", "null"] },
          "description": { "type": "string", "minLength": 1 },
          "rel32_exit": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
