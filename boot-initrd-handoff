#!/bin/sh

/bin/busybox mount -t ext2 -o rw /dev/hda2 /newroot || {
    echo "Could not mount /dev/hda2"
    exec /bin/sh
}

echo "BOOT-HANDOFF: mounted /dev/hda2"
/bin/busybox ls -l /newroot/sbin/init
/bin/busybox ls -ld /newroot/etc/passwd /newroot/etc/group /newroot/etc/webs.conf /newroot/etc/airespider/webs.conf /newroot/writable >/dev/console 2>&1 || true

# Runtime settings are generated by make-runtime-initrd.sh, rather than
# trusting arbitrary shell content supplied through the container environment.
enable_ecdsa_ssh=0
enable_root_cli=0
support_entitlement_end_epoch=0
payload_root_ssh=not_supported
virtual_build_id=
if [ -r /zd-runtime-options ]; then
    option_value=$(/bin/busybox sed -n 's/^ENABLE_ECDSA_SSH=//p' /zd-runtime-options | /bin/busybox head -n 1)
    case "$option_value" in
        0|1) enable_ecdsa_ssh=$option_value ;;
        *) echo "BOOT-HANDOFF: invalid ECDSA SSH option; using disabled" >/dev/console ;;
    esac
    option_value=$(/bin/busybox sed -n 's/^ENABLE_ROOT_CLI=//p' /zd-runtime-options | /bin/busybox head -n 1)
    case "$option_value" in
        0|1) enable_root_cli=$option_value ;;
        *) echo "BOOT-HANDOFF: invalid root CLI option; using disabled" >/dev/console ;;
    esac
    option_value=$(/bin/busybox sed -n 's/^SUPPORT_ENTITLEMENT_END_EPOCH=//p' /zd-runtime-options | /bin/busybox head -n 1)
    case "$option_value" in
        '') ;;
        *[!0-9]*) echo "BOOT-HANDOFF: invalid support entitlement date; leaving unchanged" >/dev/console ;;
        *) support_entitlement_end_epoch=$option_value ;;
    esac
    option_value=$(/bin/busybox sed -n 's/^VIRTUAL_BUILD_ID=//p' /zd-runtime-options | /bin/busybox head -n 1)
    case "$option_value" in
        ???????)
            case "$option_value" in
                *[!0-9a-f]*) echo "BOOT-HANDOFF: invalid virtual build revision; omitting it" >/dev/console ;;
                *) virtual_build_id=$option_value ;;
            esac
            ;;
        *) echo "BOOT-HANDOFF: invalid virtual build revision; omitting it" >/dev/console ;;
    esac
fi
echo "BOOT-HANDOFF: runtime root_cli=$enable_root_cli support_end=$support_entitlement_end_epoch" >/dev/console

# The production data partition is ReiserFS and the vendor mount command uses
# its `nolog` option. Our disposable data partition is legacy ext2, so remove
# that one incompatible option from the disposable root copy.
/bin/busybox sed -i 's/,nolog//' /newroot/etc/init.d/sys_init 2>/dev/null || true
# The real appliance is designed around orderly hardware shutdown.  Our ext2
# lab volume must also tolerate a terminated QEMU process, so repair it before
# mounting.  Keep the vendor's async mount behavior: forcing synchronous I/O
# makes its database migration and adapter startup impractically slow.
/newroot/sbin/e2fsck -p /dev/hda4 >/dev/console 2>&1
fsck_status=$?
if [ "$fsck_status" -ge 4 ]; then
    echo "BOOT-HANDOFF: hda4 needs full automatic repair ($fsck_status)" >/dev/console
    /newroot/sbin/e2fsck -f -y /dev/hda4 >/dev/console 2>&1
    fsck_status=$?
fi
if [ "$fsck_status" -ge 4 ]; then
    echo "BOOT-HANDOFF: hda4 filesystem repair failed ($fsck_status); refusing to mount it" >/dev/console
    exec /bin/sh
fi
# The synthetic partition table gives hda4 about 1.43 GiB, but its seed is a
# byte-for-byte copy of the 143 MiB root filesystem. Copying the seed does not
# grow its ext2 superblock, leaving only enough free space for a truncated AP
# image. Expand the existing, checked filesystem in place to its partition
# boundary. Repeating resize2fs on later boots is harmless.
/newroot/sbin/resize2fs /dev/hda4 >/dev/console 2>&1
resize_status=$?
if [ "$resize_status" -ne 0 ]; then
    echo "BOOT-HANDOFF: hda4 filesystem expansion failed ($resize_status)" >/dev/console
else
    echo "BOOT-HANDOFF: hda4 filesystem spans its data partition" >/dev/console
fi
/bin/busybox sed -i 's/rw,sync,noatime/rw,async,noatime/' /newroot/etc/init.d/sys_init 2>/dev/null || true

# Factory setup can block in legacy SSH host-key generation while the new VM
# has very little entropy. Keep the generators inert initially; configured
# boots restore the stock Dropbear multicall symlink below.
for keygen in /newroot/bin/ssh-keygen /newroot/usr/bin/dropbearkey; do
    /bin/busybox rm -f "$keygen" 2>/dev/null || true
    /bin/busybox sh -c "printf '#!/bin/sh\\nexit 0\\n' > '$keygen'"
    /bin/busybox chmod 755 "$keygen"
done

# The ext2 data volume is seeded from the root image only to obtain a
# compatible filesystem. Remove the root image's /writable symlinks so it
# behaves like a clean data volume.
/bin/busybox mkdir -p /data
factory_web_patch=1
if /bin/busybox mount -t ext2 -o rw /dev/hda4 /data 2>/dev/null; then
    if [ ! -f /data/.zd-lab-initialized ]; then
        for p in \
            /data/.ssh /data/.rnd /data/fl \
            /data/etc/raddb /data/etc/smb.conf /data/etc/airespider-images \
            /data/etc/config /data/etc/config/passwd /data/etc/krb5.conf /data/etc/kdc.conf \
            /data/etc/airespider /data/etc/random-seed /data/etc/hosts \
            /data/etc/passwd /data/etc/share /data/writable; do
            /bin/busybox rm -f "$p" 2>/dev/null || true
        done
        /bin/busybox mkdir -p \
            /data/etc/airespider-images/oem /data/etc/airespider-images/usb_software \
            /data/etc/airespider/certs/ca /data/etc/airespider/dropbear \
            /data/etc/airespider/ssh /data/etc/airespider/dump \
            /data/etc/config /data/etc/system /data/data/dropbear
        /bin/busybox mkdir -p /data/etc/config
        /bin/busybox mkdir -p /data/etc/airespider/certs
        /bin/busybox cp -f /lab-certs/webaccert.pem /data/etc/airespider/certs/webaccert.pem 2>/dev/null || true
        /bin/busybox cp -f /lab-certs/webackey.pem /data/etc/airespider/certs/webackey.pem 2>/dev/null || true
        /bin/busybox cp -f /lab-certs/webaccert.pem /data/etc/airespider/certs/cacert.pem 2>/dev/null || true
        # setupRootCA() creates this marker only after certificate setup succeeds.
        # Without it, emfd's xGetCertCN path aborts during adapter initialization.
        /bin/busybox touch /data/etc/airespider/certs/ok
        /bin/busybox sh -c 'printf "root:\$1\$zdroot\$cqAOkGzVR3xPO6tSt8LH0.:0:0:root:/root:/bin/sh\nadmin:\$1\$zdadmin\$vL6u83u.zoHHuQc8U.wuS0:1000:0:admin:/home/admin:/bin/sh\nsuper:\$1\$zdroot\$cqAOkGzVR3xPO6tSt8LH0.:0:0:super:/root:/bin/sh\nnobody:*:65534:65534:nobody:/:/bin/false\n" > /data/etc/config/passwd'
        /bin/busybox sh -c 'printf "root:x:0:\nadmin:x:0:\nnobody:x:65534:\n" > /data/etc/config/group'
        /bin/busybox touch /data/.zd-lab-initialized
    fi
    # The web server and legacy AP FTP daemon use different historical names
    # for the controller certificate. Preserve existing generated credentials,
    # but repair missing aliases on every boot for already-initialized volumes.
    cert_dir=/data/etc/airespider/certs
    /bin/busybox mkdir -p "$cert_dir"
    [ -s "$cert_dir/webaccert.pem" ] || /bin/busybox cp -f /lab-certs/webaccert.pem "$cert_dir/webaccert.pem" 2>/dev/null || true
    [ -s "$cert_dir/webackey.pem" ] || /bin/busybox cp -f /lab-certs/webackey.pem "$cert_dir/webackey.pem" 2>/dev/null || true
    [ -s "$cert_dir/cacert.pem" ] || /bin/busybox cp -f /lab-certs/webaccert.pem "$cert_dir/cacert.pem" 2>/dev/null || true
    [ -s "$cert_dir/accert.pem" ] || /bin/busybox cp -f /lab-certs/webaccert.pem "$cert_dir/accert.pem" 2>/dev/null || true
    [ -s "$cert_dir/ackey.pem" ] || /bin/busybox cp -f /lab-certs/webackey.pem "$cert_dir/ackey.pem" 2>/dev/null || true
    /bin/busybox chmod 600 "$cert_dir/ackey.pem" "$cert_dir/webackey.pem" 2>/dev/null || true
    # Optional root access reuses the vendor CLI script hook. It deliberately
    # has no network listener and no bundled third-party SSH binary. Only
    # remove the project-owned link/target when disabled, never an operator's
    # unrelated .root.sh script.
    root_cli_target=/newroot/etc/persistent-scripts/.zd1200-root.sh
    root_cli_link=/data/etc/scripts/.root.sh
    /bin/busybox mkdir -p /data/etc/scripts /newroot/etc/persistent-scripts
    if [ "$enable_root_cli" = 1 ]; then
        /bin/busybox cat > "$root_cli_target" <<'ZD_ROOT_CLI'
#!/bin/sh
#RUCKUS#
/bin/stty echo
exec /bin/sh
ZD_ROOT_CLI
        /bin/busybox chmod 700 "$root_cli_target"
        /bin/busybox rm -f "$root_cli_link"
        /bin/busybox ln -s /etc/persistent-scripts/.zd1200-root.sh "$root_cli_link"
        echo "BOOT-HANDOFF: enabled diagnostic root CLI hook" >/dev/console
    elif [ "$(/bin/busybox readlink "$root_cli_link" 2>/dev/null)" = /etc/persistent-scripts/.zd1200-root.sh ]; then
        /bin/busybox rm -f "$root_cli_link" "$root_cli_target"
        echo "BOOT-HANDOFF: removed diagnostic root CLI hook" >/dev/console
    fi
    # The support entitlement is applied by the controller wrapper after the
    # vendor startup script completes.  Keep only the validated finite epoch
    # here; do not compare it in this 32-bit guest (2100 overflows signed int).
    support_option=/newroot/etc/zd1200-support-entitlement-end
    legacy_support_store=/newroot/etc/persistent-scripts/zd1200-support
    legacy_wrapper_vendor=$legacy_support_store/sys_wrapper.vendor.sh
    if [ -f "$legacy_wrapper_vendor" ]; then
        /bin/busybox cp -f "$legacy_wrapper_vendor" /newroot/bin/sys_wrapper.sh
        if [ -f /newroot/file_list.txt ]; then
            wrapper_md5=$(/bin/busybox md5sum /newroot/bin/sys_wrapper.sh | /bin/busybox awk '{print $1}')
            /bin/busybox sed -i "/\.\/bin\/sys_wrapper\.sh/s/[0-9a-f][0-9a-f]*/$wrapper_md5/" /newroot/file_list.txt
        fi
        /bin/busybox rm -rf "$legacy_support_store"
        echo "BOOT-HANDOFF: restored vendor wrapper from obsolete support adapter" >/dev/console
    fi
    if [ "$support_entitlement_end_epoch" != 0 ]; then
        /bin/busybox sh -c "printf '%s\\n' '$support_entitlement_end_epoch' > '$support_option'"
    else
        /bin/busybox rm -f "$support_option"
    fi
    # Custom dropbear-2026.94 (pubkey-only, port 2222) is deliberately
    # opt-in.  It is injected only when the runtime initramfs contains an
    # operator-supplied authorized_keys file; no default key is shipped.
    # from the initramfs payload every boot.  Host keys persist on the data
    # partition and are generated by S99zd_dropbear2222 after the pivot.
    # /data is hda4, which the controller mounts at /writable, so these two
    # copies land at /writable/dropbear2222 (used by S99) and
    # /writable/data/dropbear2222 (where the compiled SFTPSERVER_PATH points).
    if [ -r /zd-dropbear2222/authorized_keys ]; then
        for dd in /data/dropbear2222 /data/data/dropbear2222; do
            /bin/busybox mkdir -p "$dd"
            for f in dropbear dropbearkey dropbearconvert sftp-server; do
                /bin/busybox cp -f "/zd-dropbear2222/$f" "$dd/$f"
                /bin/busybox chmod 755 "$dd/$f"
            done
            /bin/busybox cp -f /zd-dropbear2222/authorized_keys "$dd/authorized_keys"
            /bin/busybox chmod 600 "$dd/authorized_keys"
        done
    fi
    # The root filesystem deliberately omits AP images; vendor upgrades seed
    # them on the writable partition.  The generated bundle includes its exact
    # release payload and a tiny layout manifest.  10.1.2 deliberately has no
    # aidfs tree, while later releases do.
    payload=/zd-payload
    payload_version="$(/bin/busybox sed -n 's/^VERSION=//p' "$payload/release-info" 2>/dev/null | /bin/busybox head -n 1)"
    payload_build="$(/bin/busybox sed -n 's/^BUILD=//p' "$payload/release-info" 2>/dev/null | /bin/busybox head -n 1)"
    payload_has_aidfs="$(/bin/busybox sed -n 's/^HAS_AIDFS=//p' "$payload/release-info" 2>/dev/null | /bin/busybox head -n 1)"
    payload_ftp_bootstrap="$(/bin/busybox sed -n 's/^RUNTIME_FTP_BOOTSTRAP=//p' "$payload/release-info" 2>/dev/null | /bin/busybox head -n 1)"
    payload_root_ssh="$(/bin/busybox sed -n 's/^RUNTIME_ROOT_SSH=//p' "$payload/release-info" 2>/dev/null | /bin/busybox head -n 1)"
    [ -n "$payload_version" ] || payload_version=unknown
    [ -n "$payload_build" ] || payload_build=unknown
    case "$payload_ftp_bootstrap" in
        vendor_state|not_required) ;;
        *)
            echo "BOOT-HANDOFF: unsupported runtime FTP profile; payload not trusted" >/dev/console
            payload_ftp_bootstrap=not_required
            ;;
    esac
    case "$payload_root_ssh" in
        vendor_dropbear_root_key|not_supported) ;;
        *)
            echo "BOOT-HANDOFF: unsupported runtime root SSH profile; key ignored" >/dev/console
            payload_root_ssh=not_supported
            ;;
    esac
    # A matching R600 control file carries its image byte counts. Include its
    # digest in the marker so a rebuilt bundle refreshes changed AP payloads.
    r600_control="$(/bin/busybox find "$payload/firmwares/r600" -type f -name '*_cntrl.rcks' 2>/dev/null | /bin/busybox head -n 1)"
    if [ -f "$r600_control" ]; then
        payload_digest="$(/bin/busybox md5sum "$r600_control" | /bin/busybox awk '{print $1}')"
        payload_marker="/data/.zd-${payload_version}.${payload_build}-payload-${payload_digest}-installed"
    else
        payload_marker="/data/.zd-${payload_version}.${payload_build}-payload-installed"
    fi
    firmware_target=/data/etc/airespider-images/firmwares
    if [ ! -f "$payload_marker" ] && [ -d "$payload/firmwares" ] \
        && [ -f "$payload/ap-models" ] \
        && [ -f "$payload/file_list.txt" ]; then
        echo "BOOT-HANDOFF: installing ZoneDirector ${payload_version}.${payload_build} payload" >/dev/console
        /bin/busybox rm -rf "$firmware_target" /data/aidfs
        /bin/busybox mkdir -p "$firmware_target"
        /bin/busybox cp -a "$payload/firmwares/." "$firmware_target/" >/dev/console 2>&1
        if [ "$payload_has_aidfs" = 1 ] && [ -d "$payload/aidfs" ]; then
            /bin/busybox mkdir -p /data/aidfs
            /bin/busybox cp -a "$payload/aidfs/." /data/aidfs/ >/dev/console 2>&1
        fi
        /bin/busybox cp -f "$payload/file_list.txt" "$firmware_target/file_list.txt"
        /bin/busybox cp -f "$payload/ap-models" /data/etc/airespider-images/ap-models
        if [ -f "$firmware_target/r600/control" ] \
            && { [ "$payload_has_aidfs" != 1 ] || [ -d /data/aidfs/web/help ]; }; then
            /bin/busybox touch "$payload_marker"
            echo "BOOT-HANDOFF: ZoneDirector ${payload_version}.${payload_build} payload installed" >/dev/console
        else
            echo "BOOT-HANDOFF: ZoneDirector ${payload_version}.${payload_build} payload installation failed" >/dev/console
        fi
    fi
    root_ssh_requested=0
    root_ssh_store=/data/zd1200-root-ssh/authorized_keys
    if [ -r /zd-root-authorized_keys ]; then
        if [ "$payload_root_ssh" = vendor_dropbear_root_key ]; then
            /bin/busybox mkdir -p /data/zd1200-root-ssh
            /bin/busybox cp -f /zd-root-authorized_keys "$root_ssh_store"
            /bin/busybox chmod 700 /data/zd1200-root-ssh
            /bin/busybox chmod 600 "$root_ssh_store"
            root_ssh_requested=1
        else
            echo "BOOT-HANDOFF: root SSH key supplied, but this release does not support it" >/dev/console
        fi
    else
        /bin/busybox rm -f "$root_ssh_store"
    fi
    /bin/busybox mkdir -p /data/zd1200-ping-monitor
    /bin/busybox rm -f /data/zd1200-ping-monitor/credentials.env
    ping_targets=/data/zd1200-ping-monitor/client-targets.conf
    if [ -r /zd-ping-client-targets ]; then
        /bin/busybox cp -f /zd-ping-client-targets "$ping_targets"
        /bin/busybox chmod 600 "$ping_targets"
    else
        /bin/busybox rm -f "$ping_targets"
    fi
    # The polling configuration is data-only and is validated again by the
    # guest startup hook before it is used for scheduling.
    /bin/busybox sed -n '/^PING_INTERVAL_SECONDS=/p;/^SNAPSHOT_INTERVAL_SECONDS=/p' \
        /zd-runtime-options > /data/zd1200-ping-monitor/intervals.conf
    /bin/busybox chmod 600 /data/zd1200-ping-monitor/intervals.conf
    # The factory wizard's SessionCheck path leaves session["cid"] empty, but
    # its two AJAX modules still reject requests unless a CSRF header matches
    # that CID.  Use narrowly patched copies until the completed wizard writes
    # an explicit non-factory state.  A normal configured boot gets originals.
    # Firmware generations encode completed-wizard state differently.
    # Accept both textual and numeric false values so configured boots restore
    # the normal Dropbear key generator and SSH service.
    if [ -f /data/etc/airespider/system.xml ] \
        && /bin/busybox grep -Eq 'is-factory="(false|0)"|factory-mode="(false|0)"' \
            /data/etc/airespider/system.xml; then
        factory_web_patch=0
    fi
    /bin/busybox umount /data 2>/dev/null || true
fi

# Match the original rescue environment: disable the physical watchdog before
# transferring control to the installed ZD userspace.
echo D > /dev/watchdog 2>/dev/null || true

# Add a disposable diagnostic startup script. The disk is opened through
# QEMU's snapshot mode, so this does not alter the source image.  The script
# is supplied as a regular initrd file; constructing it with nested shell
# quoting here caused the old S98/S99 hook to be rejected by BusyBox.
if /bin/busybox mount -o remount,rw /newroot 2>/dev/null; then
    /bin/busybox mkdir -p /newroot/etc/init.d
    if [ -n "$virtual_build_id" ]; then
        /bin/busybox sh -c "printf '%s\\n' '$virtual_build_id' > /newroot/etc/zd1200-virtual-build-id"
        /bin/busybox chmod 444 /newroot/etc/zd1200-virtual-build-id
    else
        /bin/busybox rm -f /newroot/etc/zd1200-virtual-build-id
    fi
    # /bin/MODEL normally points at /proc/v54bsp/model.  The synthetic
    # boarddata is sufficient for the kernel driver to start, but leaves that
    # proc entry empty.  libemf's OEM-string loader assumes the first line is
    # non-empty and otherwise calls pstrlwr(NULL), crashing emfd before it can
    # create /tmp/esp or launch webs.  Supply the identity of the hardware
    # whose firmware image this is; QEMU snapshot mode keeps this disposable.
    /bin/busybox rm -f /newroot/bin/MODEL
    /bin/busybox sh -c 'printf "zd1200\n" > /newroot/bin/MODEL'
    /bin/busybox chmod 444 /newroot/bin/MODEL
    /bin/busybox ln -sf /bin/ruckus_cli2 /newroot/bin/rkscli
    # Several older ZD factory images start udhcpc in background mode and do
    # not run its documented 192.168.0.2 fallback while no DHCP server exists.
    # Change only the immutable *factory template*, before it is copied to a
    # new writable state partition.  The setup wizard remains authoritative
    # for the eventual DHCP/static production choice.
    if [ -f /newroot/etc/airespider-default/system.xml ]; then
        /bin/busybox sed -i \
            's/<mgmt-ip by-dhcp="true" ip="192\.168\.0\.2"/<mgmt-ip by-dhcp="false" ip="192.168.0.2"/' \
            /newroot/etc/airespider-default/system.xml
    fi
    # Bring-up diagnostics are deliberately absent from normal boots.  Their
    # repeated process/map dumps noticeably slow TCG emulation and flood the
    # serial log once the controller is known to initialize correctly.
    /bin/busybox rm -f /newroot/etc/init.d/S98zd_diag
    /bin/busybox rm -f /newroot/etc/init.d/S98backend_diag
    /bin/busybox cp -f /zd-memory-snapshot.sh /newroot/etc/init.d/S98memory_snapshot
    /bin/busybox chmod 755 /newroot/etc/init.d/S98memory_snapshot
    # The monitor publishes fixed same-origin JSON and raw configuration
    # captures. Its settings form writes only through ZD's authenticated native
    # preference endpoint; no custom CGI or EJS extension is required.
    if [ -r /zd-analytics/ping-monitor.html ] \
        && [ -x /zd-analytics/ping-monitor ] \
        && [ -x /zd-analytics/zd1200-local-getstat ] \
        && [ -x /zd-analytics/network-snapshot-collect.sh ] \
        && [ -x /zd-analytics/ping-monitor-settings-sync.sh ]; then
        /bin/busybox mkdir -p /newroot/usr/local/sbin
        # The selected vendor root does not provide a standalone sed utility.
        # Preserve the static BusyBox from this handoff environment for the
        # late hook that must alter the active UI bundle after pivot.
        /bin/busybox cp -f /bin/busybox /newroot/usr/local/sbin/busybox
        /bin/busybox chmod 755 /newroot/usr/local/sbin/busybox
        /bin/busybox cp -f /zd-analytics/ping-monitor /newroot/usr/local/sbin/zd1200-ping-monitor
        /bin/busybox chmod 755 /newroot/usr/local/sbin/zd1200-ping-monitor
        /bin/busybox cp -f /zd-analytics/network-snapshot-collect.sh /newroot/usr/local/sbin/zd1200-network-snapshot-collect
        /bin/busybox chmod 755 /newroot/usr/local/sbin/zd1200-network-snapshot-collect
        /bin/busybox cp -f /zd-analytics/zd1200-local-getstat /newroot/usr/local/sbin/zd1200-local-getstat
        /bin/busybox chmod 755 /newroot/usr/local/sbin/zd1200-local-getstat
        /bin/busybox cp -f /zd-analytics/ping-monitor-settings-sync.sh /newroot/usr/local/sbin/zd1200-ping-monitor-settings-sync
        /bin/busybox chmod 755 /newroot/usr/local/sbin/zd1200-ping-monitor-settings-sync
        /bin/busybox cp -f /zd-analytics/ping-monitor.html /newroot/web/admin10/zd1200-ping-monitor.html
        /bin/busybox chmod 644 /newroot/web/admin10/zd1200-ping-monitor.html
        # app.jsp loads app.js for the regular console. Keep the menu patch in
        # a small idempotent helper because the selected vendor root can replace
        # the early /newroot view during pivot. The late init hook invokes it
        # against the active root and refreshes the precompressed asset too.
        /bin/busybox cat > /newroot/usr/local/sbin/zd1200-patch-ping-menu <<'ZD_PING_MENU_PATCH'
#!/bin/sh
root=${1:-}
if [ -n "$root" ]; then
    bb=/bin/busybox
else
    bb=/usr/local/sbin/busybox
fi
bundle=$root/web/build/app.js
compressed=$bundle.gz
marker=zd1200_ping_monitor
panel_marker=zd1200-ping-monitor-panel-v2
changed=0

[ -r "$bundle" ] || exit 1
if "$bb" grep -q 'id:"zd1200_ping_monitor",title:"Ping Monitor"' "$bundle"; then
    "$bb" sed -i \
        -e 's|{id:"zd1200_ping_monitor",title:"Ping Monitor",url:"/admin10/zd1200-ping-monitor.html"}|{id:"zd1200_ping_monitor",title:"Ping Monitor",url:"javascript:window.zd1200ShowPingMonitor()"}|g' \
        -e 's|{id:"zd1200_ping_monitor",title:"Ping Monitor",location:"zd1200_ping_monitor",url:"/admin10/app.jsp#zd1200_ping_monitor"}|{id:"zd1200_ping_monitor",title:"Ping Monitor",url:"javascript:window.zd1200ShowPingMonitor()"}|g' \
        "$bundle"
    changed=1
fi
if ! "$bb" grep -q "$marker" "$bundle"; then
    "$bb" sed -i \
        -e 's|children:\[a,n,r\]})|children:[a,n,r,{id:"zd1200_ping_monitor",title:"Ping Monitor",url:"javascript:window.zd1200ShowPingMonitor()"}]})|g' \
