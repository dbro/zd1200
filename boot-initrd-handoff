    intervals=/writable/zd1200-ping-monitor/intervals.conf
    settings_status=/writable/zd1200-ping-monitor/settings.json
    client_snapshot=
    preference_updated_at=
    # Collection is opt-in on a fresh controller. A saved native preference
    # remains authoritative after the administrator enables either collector.
    ping_enabled=0
    snapshot_enabled=0
    ping_interval=60
    snapshot_interval=300
    last_ping=0
    last_snapshot=0
    settings_source=defaults
    mkdir -p /writable/zd1200-ping-monitor "$snapshot_dir"
    # Remove the obsolete persistent transfer files from the earlier bridge.
    rm -f /writable/zd1200-ping-monitor/native-settings.conf \
        /writable/zd1200-ping-monitor/.settings-session.cookie \
        /writable/zd1200-ping-monitor/.settings-csrf
    rm -rf /writable/zd1200-ping-monitor/getstat-probe
    if [ -r "$intervals" ]; then
        configured_ping=$(sed -n 's/^PING_INTERVAL_SECONDS=//p' "$intervals" | head -n 1)
        configured_snapshot=$(sed -n 's/^SNAPSHOT_INTERVAL_SECONDS=//p' "$intervals" | head -n 1)
        case "$configured_ping" in ''|*[!0-9]*) ;; *) [ "$configured_ping" -ge 30 ] && [ "$configured_ping" -le 3600 ] && ping_interval=$configured_ping;; esac
        case "$configured_snapshot" in ''|*[!0-9]*) ;; *) [ "$configured_snapshot" -ge 30 ] && [ "$configured_snapshot" -le 3600 ] && snapshot_interval=$configured_snapshot;; esac
    fi
    apply_native_settings() {
        native_values=$1
        old_ping_enabled=$ping_enabled
        old_snapshot_enabled=$snapshot_enabled
        if [ -n "$native_values" ]; then
            configured_has_native=$(printf '%s\n' "$native_values" | sed -n 's/^HAS_NATIVE_SETTINGS=//p' | head -n 1)
            configured_ping_enabled=$(printf '%s\n' "$native_values" | sed -n 's/^PING_ENABLED=//p' | head -n 1)
            configured_ping=$(printf '%s\n' "$native_values" | sed -n 's/^PING_INTERVAL_SECONDS=//p' | head -n 1)
            configured_snapshot_enabled=$(printf '%s\n' "$native_values" | sed -n 's/^SNAPSHOT_ENABLED=//p' | head -n 1)
            configured_snapshot=$(printf '%s\n' "$native_values" | sed -n 's/^SNAPSHOT_INTERVAL_SECONDS=//p' | head -n 1)
            configured_updated=$(printf '%s\n' "$native_values" | sed -n 's/^PREFERENCE_UPDATED_AT=//p' | head -n 1)
            valid_native=1
            [ "$configured_has_native" = 1 ] || valid_native=0
            case "$configured_ping_enabled" in 0|1) ;; *) valid_native=0;; esac
            case "$configured_snapshot_enabled" in 0|1) ;; *) valid_native=0;; esac
            case "$configured_updated" in ''|*[!0-9]*) valid_native=0;; esac
            case "$configured_ping" in ''|*[!0-9]*) valid_native=0;; *) [ "$configured_ping" -ge 30 ] && [ "$configured_ping" -le 3600 ] || valid_native=0;; esac
            case "$configured_snapshot" in ''|*[!0-9]*) valid_native=0;; *) [ "$configured_snapshot" -ge 30 ] && [ "$configured_snapshot" -le 3600 ] || valid_native=0;; esac
            if [ "$valid_native" = 1 ]; then
                ping_enabled=$configured_ping_enabled
                ping_interval=$configured_ping
                snapshot_enabled=$configured_snapshot_enabled
                snapshot_interval=$configured_snapshot
                preference_updated_at=$configured_updated
                settings_source=zd-preference
            fi
        fi
        [ "$old_ping_enabled" = 0 ] && [ "$ping_enabled" = 1 ] && last_ping=0
        [ "$old_snapshot_enabled" = 0 ] && [ "$snapshot_enabled" = 1 ] && last_snapshot=0
    }
    publish_settings() {
        ping_boolean=false
        snapshot_boolean=false
        [ "$ping_enabled" = 1 ] && ping_boolean=true
        [ "$snapshot_enabled" = 1 ] && snapshot_boolean=true
        updated_json=null
        [ -n "$preference_updated_at" ] && updated_json=$preference_updated_at
        temporary="$settings_status.tmp.$$"
        printf '{"status":"ok","ping_enabled":%s,"ping_interval":%s,"snapshot_enabled":%s,"snapshot_interval":%s,"source":"%s","preference_updated_at":%s,"checked_at":%s}\n' \
            "$ping_boolean" "$ping_interval" "$snapshot_boolean" \
            "$snapshot_interval" "$settings_source" "$updated_json" \
            "$(date +%s)" > "$temporary"
        mv -f "$temporary" "$settings_status"
    }
    if [ -r "$configured_targets" ]; then
        old_ifs=$IFS
        IFS=';'
        for target in $(cat "$configured_targets"); do
            IFS='|'
            set -- $target
            if [ "$#" -eq 3 ]; then
                /usr/local/sbin/zd1200-ping-monitor add-client "$1" "$2" "$3" 2>/dev/null || true
            fi
        done
        IFS=$old_ifs
    fi
    native_values=$(/usr/local/sbin/zd1200-ping-monitor-settings-sync 2>/dev/null || true)
    apply_native_settings "$native_values"
    publish_settings
    while :; do
        # Read and validate the persistent native ZD preference directly from
        # its root-only configuration. Keep the last valid value in process
        # memory if ZD is temporarily unavailable.
        native_values=$(/usr/local/sbin/zd1200-ping-monitor-settings-sync 2>/dev/null || true)
        apply_native_settings "$native_values"
        publish_settings
        now=$(date +%s)
        if [ "$snapshot_enabled" = 1 ] \
            && [ $((now - last_snapshot)) -ge "$snapshot_interval" ]; then
            # A failed collection must not reuse an old association view. The
            # helper records that case as "unknown", rather than presenting a
            # stale client state as current evidence.
            client_snapshot=
            if /usr/local/sbin/zd1200-network-snapshot-collect 2>/dev/null; then
                client_snapshot=$(ls -1t "$snapshot_dir"/*-client.xml 2>/dev/null | head -n 1 || true)
            fi
            /usr/local/sbin/zd1200-ping-monitor prune-snapshots 2>/dev/null || true
            temporary="$snapshot_index.tmp.$$"
            if /usr/local/sbin/zd1200-ping-monitor snapshot-index > "$temporary"; then
                mv -f "$temporary" "$snapshot_index"
            else
                rm -f "$temporary"
            fi
            last_snapshot=$now
        elif [ "$snapshot_enabled" = 0 ]; then
            client_snapshot=
        fi
        if [ "$ping_enabled" = 1 ] \
            && [ $((now - last_ping)) -ge "$ping_interval" ]; then
            /usr/local/sbin/zd1200-ping-monitor tick "$client_snapshot" 2>/dev/null || true
            temporary="$output.tmp.$$"
            if /usr/local/sbin/zd1200-ping-monitor pings-json > "$temporary"; then
                mv -f "$temporary" "$output"
            else
                rm -f "$temporary"
            fi
            last_ping=$now
        fi
        sleep 30
    done
) &
exit 0
ZD_PING_MONITOR_INIT
        /bin/busybox chmod 755 /newroot/etc/init.d/S99zd_ping_monitor
    fi

    # Docker lifecycle control uses an emulated second serial port. It is a
    # private, non-networked channel that accepts one exact command and invokes
    # the stock BusyBox PID-1 reboot path so databases and filesystems flush
    # before the host terminates QEMU.
    /bin/busybox cat > /newroot/etc/init.d/S98zd_container_control <<'ZD_CONTAINER_CONTROL'
#!/bin/sh
(
    while IFS= read -r command; do
        [ "$command" = reboot ] || continue
        echo "ZD-CONTAINER-CONTROL: orderly reboot requested" >/dev/console
        exec /sbin/reboot
    done < /dev/ttyS1
) &
ZD_CONTAINER_CONTROL
    /bin/busybox chmod 755 /newroot/etc/init.d/S98zd_container_control
    # Keep the vendor account database path. In particular, legacy AP-image
    # FTP authenticates its internal service account through this writable
    # database. Replacing it with a static passwd file makes vsftpd listen but
    # rejects every AP login. Dropbear's shell check is handled below instead.
    /bin/busybox rm -f /newroot/etc/passwd
    /bin/busybox ln -s /writable/etc/config/passwd /newroot/etc/passwd
    /bin/busybox sh -c 'printf "/bin/ash\n/bin/sh\n/sbin/rkscli\n" > /newroot/etc/shells'
    /bin/busybox chmod 644 /newroot/etc/shells
    # Remove any old diagnostic listener before considering an opt-in payload.
    /bin/busybox rm -f /newroot/etc/init.d/S99zd_dropbear2222
    # Optional root SSH uses the vendor Dropbear binary, not an unprovenanced
    # bundled daemon. It is a separate port with password auth disabled, so
    # the ordinary administrative SSH service and its login wrapper remain
    # unchanged. The key is stored on the writable partition; remove only the
    # symlink and data path owned by this project when the option is unset.
    root_ssh_link=/newroot/root/.ssh/authorized_keys
    root_ssh_target=/writable/zd1200-root-ssh/authorized_keys
    /bin/busybox rm -f /newroot/etc/init.d/S61zd_root_ssh
    if [ "$root_ssh_requested" = 1 ]; then
        /bin/busybox mkdir -p /newroot/root/.ssh
        /bin/busybox chmod 700 /newroot/root/.ssh
        if [ -e "$root_ssh_link" ] || [ -L "$root_ssh_link" ]; then
            if [ "$(/bin/busybox readlink "$root_ssh_link" 2>/dev/null)" != "$root_ssh_target" ]; then
                # Do not turn an operator-managed root key into a project
                # listener. This option owns only its explicit symlink.
                echo "BOOT-HANDOFF: existing root authorized_keys is not project-owned; root SSH left disabled" >/dev/console
                root_ssh_requested=0
            fi
        else
            /bin/busybox ln -s "$root_ssh_target" "$root_ssh_link"
        fi
    fi
    if [ "$root_ssh_requested" = 1 ]; then
        /bin/busybox cat > /newroot/etc/init.d/S61zd_root_ssh <<'ZD_ROOT_SSH_INIT'
#!/bin/sh
key=/root/.ssh/authorized_keys
hostkey=/etc/airespider/dropbear/dropbear_host_rsa_key
[ -r "$key" ] && [ -r "$hostkey" ] || exit 0
exec /usr/sbin/dropbear -p 2222 -P /var/run/zd1200-root-dropbear.pid \
    -s -j -k -e /bin/sh -r "$hostkey"
ZD_ROOT_SSH_INIT
        /bin/busybox chmod 755 /newroot/etc/init.d/S61zd_root_ssh
        echo "BOOT-HANDOFF: enabled vendor-Dropbear root SSH on TCP 2222" >/dev/console
    elif [ "$(/bin/busybox readlink "$root_ssh_link" 2>/dev/null)" = "$root_ssh_target" ]; then
        /bin/busybox rm -f "$root_ssh_link"
    fi
    # Preserve the vendor Dropbear launcher and make the ECDSA compatibility
    # choice reversible.  Dropbear accepts multiple -r host-key arguments, so
    # RSA remains available to legacy clients.  S59 creates the ECDSA key
    # before the vendor S60dropbear link executes, but only after setup has
    # completed and the real Dropbear key generator has been restored.
    dropbear_script=/newroot/etc/init.d/dropbear
    dropbear_vendor=/newroot/etc/init.d/dropbear.vendor
    if [ -f "$dropbear_script" ] && [ ! -f "$dropbear_vendor" ]; then
        /bin/busybox cp -f "$dropbear_script" "$dropbear_vendor"
    fi
    if [ -f "$dropbear_vendor" ]; then
        /bin/busybox cp -f "$dropbear_vendor" "$dropbear_script"
    fi
    /bin/busybox rm -f /newroot/etc/init.d/S59zd_ecdsa_hostkey
    if [ "$enable_ecdsa_ssh" = 1 ] && [ -f "$dropbear_script" ]; then
        ecdsa_key=/etc/airespider/dropbear/dropbear_host_ecdsa_key
        if /bin/busybox grep -q -- "$ecdsa_key" "$dropbear_script"; then
            echo "BOOT-HANDOFF: ECDSA SSH host key already enabled" >/dev/console
        elif /bin/busybox grep -q -- 'dropbear_host_rsa_key' "$dropbear_script"; then
            /bin/busybox sed -i "s| -r /etc/airespider/dropbear/dropbear_host_rsa_key| -r /etc/airespider/dropbear/dropbear_host_rsa_key -r $ecdsa_key|" "$dropbear_script"
            echo "BOOT-HANDOFF: enabled ECDSA alongside RSA for Dropbear" >/dev/console
        else
            echo "BOOT-HANDOFF: Dropbear RSA key invocation was not recognized; ECDSA left disabled" >/dev/console
        fi
        if /bin/busybox grep -q -- "$ecdsa_key" "$dropbear_script"; then
            /bin/busybox cat > /newroot/etc/init.d/S59zd_ecdsa_hostkey <<'ZD_ECDSA_INIT'
#!/bin/sh
key=/etc/airespider/dropbear/dropbear_host_ecdsa_key
if [ ! -s "$key" ] && [ -x /usr/bin/dropbearkey ]; then
    /usr/bin/dropbearkey -t ecdsa -f "$key"
    chmod 600 "$key" 2>/dev/null || true
fi
ZD_ECDSA_INIT
            /bin/busybox chmod 755 /newroot/etc/init.d/S59zd_ecdsa_hostkey
        fi
    fi
    if [ ! -f /newroot/etc/init.d/controller.vendor ]; then
        /bin/busybox cp -f /newroot/etc/init.d/controller /newroot/etc/init.d/controller.vendor
    fi
    /bin/busybox cp -f /zd-controller-wrapper.sh /newroot/etc/init.d/controller
    /bin/busybox chmod 755 /newroot/etc/init.d/controller
