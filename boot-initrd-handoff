    # reset-flag step a no-op before returning the synthetic root read-only.
    /bin/busybox sh -c 'printf "#!/bin/sh\nexit 0\n" > /newroot/etc/init.d/S70resetflag'
    /bin/busybox chmod 755 /newroot/etc/init.d/S70resetflag
