# Install as /etc/default/zd1200-bridge and adapt to the dedicated adapter.
# This interface is deliberately left unnumbered and must not carry the host's
# default route.
ZD_USB_IF=enx0123456789ab
# Optional defence against selecting the wrong USB adapter. Leave empty to
# disable the MAC check.
ZD_USB_MAC=00:00:00:00:00:00
ZD_BRIDGE_IF=br-zd
ZD_TAP_IF=tap-zd
