# Install as /etc/default/zd1200-bridge. Choose exactly one network profile.
#
# dedicated (the default and recommended profile): the helper exclusively owns
# this adapter, creates br-zd, and refuses to start if this adapter or br-zd
# carries the host default route.
ZD_NETWORK_PROFILE=dedicated
ZD_USB_IF=enx0123456789ab
# Optional defence against selecting the wrong USB adapter. Leave empty to
# disable the MAC check.
ZD_USB_MAC=00:00:00:00:00:00
ZD_BRIDGE_IF=br-zd
ZD_TAP_IF=tap-zd

# existing-bridge (advanced shared-LAN profile): set the profile and the name
# of a Linux bridge already created and owned by the host.  Leave ZD_USB_IF
# and ZD_USB_MAC unset.  The helper only creates/removes ZD_TAP_IF; it never
# changes the existing bridge, its member interfaces, addresses, routes, STP,
# or bridge settings.
# ZD_NETWORK_PROFILE=existing-bridge
# ZD_BRIDGE_IF=br0
# ZD_TAP_IF=tap-zd
