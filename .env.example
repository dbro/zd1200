# Copy to .env and set values for your host. Do not commit .env.
# Put the downloaded Ruckus ZD archive in ./vendor/ and set only its basename
# here. The one-shot Compose preparation service reads it read-only and writes
# derived runtime files to the named volume below; it never puts vendor bytes
# in a Docker image layer.
ZD_VENDOR_DIR=./vendor
ZD_VENDOR_ARCHIVE=zd1200_10.5.1.0.282.ap_10.5.1.0.282.img
# On 10.5.1, Compose builds the patched unsigned R600 image automatically
# from the ZD payload. Older scoped releases do not need this repair.
ZD_RUNTIME_VOLUME=zd1200-runtime
ZD_TAP_IF=tap-zd
ZD_CONTAINER_NAME=zd1200
ZD_STATE_VOLUME=zd1200-state
# Automatically use the appropriate launcher readiness behavior: no HTTP
# probe for the normal TAP network, and a local probe for user-mode networking.
ZD_WEB_PROBE=auto

# Advanced alternative to the dedicated-adapter setup. Leave these unset for
# the normal docker-compose.yml profile. To use docker-compose.macvlan.yml,
# set all three values for the intended wired management VLAN.
# ZD_MACVLAN_PARENT=eno1
# ZD_MACVLAN_SUBNET=192.168.222.0/24
# ZD_MACVLAN_GATEWAY=192.168.222.1

# Leave both unset to generate one unique, locally administered identity in
# the persistent state volume. To override it, set both values (MAC2 is MAC1+1).
# ZD_SERIAL=123456000789
# ZD_MAC1=02:52:54:12:00:01

# Optional SSH compatibility: retain RSA and additionally advertise an ECDSA
# host key on the normal ZoneDirector administrative SSH service.
ZD_ENABLE_ECDSA_SSH=0

# Opt-in diagnostic root shell through the existing ZD CLI script hook. This
# does not expose a new SSH listener; see README.md before enabling it.
ZD_ENABLE_ROOT_CLI=0

# Optional root SSH, using the vendor Dropbear binary on TCP 2222. Supply one
# RSA or ECDSA public-key line; it is supported and validated only for
# 10.5.1.0.282 (the vendor Dropbear does not support Ed25519 keys).
# ZD_ROOT_SSH_PUBLIC_KEY=ecdsa-sha2-nistp256 AAAA... user@host

# Optional finite support entitlement. Omit or leave empty to preserve the
# vendor state. A value must be a valid date later than 2010-01-01.
# ZD_SUPPORT_ENTITLEMENT_END=2100-01-01

# Optional Ping Monitor account. Create a separate ZD Monitoring Admin user
# and set both values. They are copied into a root-only file on the persistent
# guest data volume, used only for localhost read-only XML snapshots.
# ZD_SNAPSHOT_USERNAME=snapshot-monitor-example
# ZD_SNAPSHOT_PASSWORD=replace-with-a-unique-password

# Ping Monitor automatically discovers currently connected APs and clients.
# These independent intervals are validated between 30 and 3600 seconds.
ZD_PING_INTERVAL_SECONDS=60
ZD_SNAPSHOT_INTERVAL_SECONDS=60
